# Apply buffs to all team members
# HUNTER: saturation, strength, regeneration
# HUNTED: saturation only
effect give @a[tag=hagk.participant,team=HUNTER] minecraft:saturation 3 1 true
effect give @a[tag=hagk.participant,team=HUNTED] minecraft:saturation 3 1 true
effect give @a[tag=hagk.participant,team=HUNTER] minecraft:strength 3 10 true
effect give @a[tag=hagk.participant,team=HUNTER] minecraft:regeneration 3 5 true
